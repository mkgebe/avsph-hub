# Both NEXT_PUBLIC_ values are safe in the browser. Every table is behind
# row level security, so what a signed-in user can reach is decided by the
# database, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=https://dckqjlsbwyofyiuxwkwe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wpuxAlnOD6AkLF-PbVCU9w_f4qok-Z7

# Server only. Bypasses row level security entirely, so it must never carry a
# NEXT_PUBLIC_ prefix and must never be committed. Copy it from
# Supabase dashboard -> Project Settings -> API -> service_role.
# Used by the /api/staff and /api/admins route handlers to create auth users.
SUPABASE_SERVICE_ROLE_KEY=
